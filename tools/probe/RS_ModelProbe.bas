Attribute VB_Name = "RS_ModelProbe"
Option Explicit
'=============================================================================
' Asks THIS copy of MS Project which object-model members it actually has,
' and writes the answers to a text file to bring back.
'
' WHY: the type model we check our VBA against was assembled from Microsoft's
' published reference. Published references drift from shipped type libraries,
' and a model that claims a member exists when it doesn't is worse than no
' model - it blesses a typo. This closes that gap with evidence.
'
' TO RUN:
'   1. Alt+F11 in MS Project
'   2. Insert > Module, paste all of this in
'   3. click inside ExportProjectModel and press F5
'   4. a MsgBox gives you the file path - send that file back
'
' Open a real project file first (one with tasks, resources and assignments),
' or the members that need a sample object can't be asked. Use a COPY.
'
' WHAT THIS READS, AND WHY THAT DISTINCTION MATTERS
'
' Version 1 of this macro claimed to be read-only because it only ever used
' CallByName with VbGet. That was wrong, and it closed MS Project.
'
'   CallByName(obj, name, VbGet) on a zero-argument METHOD does not read
'   anything. It CALLS it.
'
' Probing Application in alphabetical order therefore ran CalculateAll,
' CalculateProject, CloseUndoTransaction, LevelNow - which re-levels the whole
' project and can move dates - and then Quit, which is why Project vanished.
' It stopped there only because Application sorts before Task; another few
' names and it would have called Task.Delete the same way.
'
' So this version:
'   - probes PROPERTIES only. Methods are listed as NOT-PROBED-METHOD and
'     never touched, because there is no way to test whether a method exists
'     without running it.
'   - skips Application entirely. Its members ARE the command surface, and
'     nothing about it is type-checked anyway.
'   - refuses a hard-coded list of names whatever the model says about them,
'     in case a method is ever mislabelled as a property.
'
' Reads are still late-bound, so a member your version lacks is a runtime
' error this records rather than a compile error that stops the module.
'
' GENERATED by tools/make_probe_macro.py - edit the model, not this.
'=============================================================================

Private mOut As String

Public Sub ExportProjectModel()
    Dim app As Object, path As String, n As Long
    Set app = Application

    ' Asking first, because the previous version of this macro closed
    ' Project without warning.
    If MsgBox("Read the object model of this project and write a report?" & _
              vbCrLf & vbCrLf & "Project: " & ProjName(app) & vbCrLf & vbCrLf & _
              "Properties are read; methods are NOT called. Nothing is " & _
              "written to your project." & vbCrLf & vbCrLf & _
              "Even so, use a copy of the file if it matters.", _
              vbOKCancel + vbQuestion, "RS Model Probe") <> vbOK Then Exit Sub

    mOut = ""
    Say "RS PROJECT MODEL PROBE v3 - properties only, Set retry"
    Say "generated-from: models/msproject.json"
    Say ""

    Header app
    Refs app
    Fields app
    n = Members(app)

    Say ""
    Say "END - " & n & " members probed"

    path = OutPath(app)
    If WriteOut(path) Then
        MsgBox "Written to:" & vbCrLf & vbCrLf & path & vbCrLf & vbCrLf & _
               "Send that file back. " & n & " members were probed.", _
               vbInformation, "RS Model Probe"
    Else
        MsgBox "Couldn't write the file. The report is in the Immediate " & _
               "window instead (Ctrl+G) - copy from there.", _
               vbExclamation, "RS Model Probe"
        Debug.Print mOut
    End If
End Sub

Private Function ProjName(ByVal app As Object) As String
    On Error Resume Next
    ProjName = app.ActiveProject.Name
    If Len(ProjName) = 0 Then ProjName = "(none open)"
    Err.Clear
End Function

'--- what version are we even talking to ------------------------------------
Private Sub Header(ByVal app As Object)
    Say "[HOST]"
    SayTry app, "Name"
    SayTry app, "Version"
    SayTry app, "Build"
    SayTry app, "OperatingSystem"
    SayTry app, "Path"
    On Error Resume Next
    Say "ActiveProject.Name=" & app.ActiveProject.Name
    Say "Tasks.Count=" & app.ActiveProject.Tasks.Count
    Say "Resources.Count=" & app.ActiveProject.Resources.Count
    Err.Clear
    On Error GoTo 0
    Say ""
End Sub

' One member, reported whatever happens. Late-bound, so a member this version
' hasn't got is an error string rather than a module that won't compile.
Private Sub SayTry(ByVal o As Object, ByVal nm As String)
    On Error Resume Next
    Dim v As Variant
    v = CallByName(o, nm, VbGet)
    If Err.Number = 0 Then
        Say nm & "=" & CStr(v)
    Else
        Say nm & "=<err " & Err.Number & ">"
    End If
    Err.Clear
    On Error GoTo 0
End Sub

'--- which type libraries this project references ---------------------------
' The exact GUID and version is what tells us which MSPRJ typelib the model
' should be matched against. Needs "Trust access to the VBA project object
' model" in Trust Center > Macro Settings; says so plainly when it's blocked.
Private Sub Refs(ByVal app As Object)
    Dim vbp As Object, r As Object, n As Long
    Say "[REFERENCES]"
    On Error Resume Next
    Set vbp = app.VBE.ActiveVBProject
    If vbp Is Nothing Or Err.Number <> 0 Then
        Say "BLOCKED - no VBE access (Trust Center > Macro Settings >"
        Say "          Trust access to the VBA project object model)"
        Err.Clear
        Say ""
        Exit Sub
    End If
    For Each r In vbp.References
        n = n + 1
        Say "ref" & n & "|name=" & r.Name & "|guid=" & r.GUID & _
            "|ver=" & r.Major & "." & r.Minor & "|builtin=" & r.BuiltIn
        Say "      desc=" & r.Description
        Say "      path=" & r.FullPath
    Next r
    Err.Clear
    On Error GoTo 0
    Say ""
End Sub

'--- field names and the constants behind them ------------------------------
' Our code finds columns by their LABEL, so the mapping between a label, its
' Text number and its pj constant is the part we most need to be right about.
' pjStandard didn't exist and cost a module; this is where that gets caught.
Private Sub Fields(ByVal app As Object)
    Dim i As Long, k As Long, nm As String, c As Variant, loc As Variant
    Say "[FIELDS]"
    Say "# name | FieldNameToFieldConstant(name, kind) per kind 0,1,2 |"
    Say "#        CustomFieldGetName(constant) = the label in THIS file"
    On Error Resume Next
    For k = 0 To 2
        For i = 1 To 30
            nm = "Text" & i
            Err.Clear
            c = app.FieldNameToFieldConstant(nm, k)
            If Err.Number = 0 Then
                Err.Clear
                loc = app.CustomFieldGetName(c)
                If Err.Number <> 0 Then loc = ""
                Say "kind" & k & "|" & nm & "|const=" & c & "|label=" & loc
            Else
                Say "kind" & k & "|" & nm & "|const=<err " & Err.Number & ">"
            End If
        Next i
    Next k
    Err.Clear
    On Error GoTo 0
    Say ""
End Sub

