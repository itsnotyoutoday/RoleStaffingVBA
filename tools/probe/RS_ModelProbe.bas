    End If

    Members = n
End Function

' WHAT 438 DOES AND DOESN'T TELL US
'
' "Object doesn't support this property or method" comes back for THREE
' different situations, and only one of them means the member is absent:
'
'   1. it really isn't a member of this version
'   2. it returns an object with no default property, so assigning it to a
'      Variant fails even though the member is fine - retried with Set below
'   3. it is write-only, or hidden in the type library and undocumented.
'      Nothing can distinguish this from case 1 by reading.
'
' Case 3 is not hypothetical. Project.NewTasksAreManual reports 438 here,
' is absent from Microsoft's published property list, and is nonetheless
' REAL - our own code assigns to it from an early-bound Project variable,
' which would not compile at all if the member didn't exist.
'
' So the label is NOT-READABLE, never MISSING. Removing something from the
' model needs this plus the documentation agreeing, not this alone.
Private Sub Probe(ByVal cls As String, ByVal o As Object, ByVal nm As String)
    Dim v As Variant, o2 As Object, e As Long
    On Error Resume Next
    v = CallByName(o, nm, VbGet)
    e = Err.Number
    Err.Clear

    If e = 438 Then
        ' Could just be an object with no default property.
        Set o2 = CallByName(o, nm, VbGet)
        If Err.Number = 0 Then
            Err.Clear
            On Error GoTo 0
            Say cls & "|" & nm & "|OK-OBJECT"
            Exit Sub
        End If
        Err.Clear
    End If
    On Error GoTo 0

    Select Case e
        Case 0
            Say cls & "|" & nm & "|OK"
        Case 449, 450
            Say cls & "|" & nm & "|ARGS"
        Case 438
            Say cls & "|" & nm & "|NOT-READABLE"
        Case Else
            Say cls & "|" & nm & "|ERR" & e
    End Select
End Sub

'--- sample objects, by navigation, read-only -------------------------------
' Not Tasks(1): a blank row or a row deleted earlier leaves a Nothing in the
' collection, and Project raises on it rather than returning Nothing.
Private Function FirstTask(ByVal app As Object) As Object
    Dim t As Object
    On Error Resume Next
    For Each t In app.ActiveProject.Tasks
        If Not t Is Nothing Then
            Set FirstTask = t
            Exit Function
        End If
    Next t
    Err.Clear
End Function

Private Function FirstRes(ByVal app As Object) As Object
    Dim r As Object
    On Error Resume Next
    For Each r In app.ActiveProject.Resources
        If Not r Is Nothing Then
            Set FirstRes = r
            Exit Function
        End If
    Next r
    Err.Clear
End Function

Private Function FirstAsg(ByVal app As Object) As Object
    Dim t As Object, a As Object
    On Error Resume Next
    For Each t In app.ActiveProject.Tasks
        If Not t Is Nothing Then
            For Each a In t.Assignments
                Set FirstAsg = a
                Exit Function
            Next a
        End If
    Next t
    Err.Clear
End Function

'--- output ----------------------------------------------------------------
Private Sub Say(ByVal s As String)
    mOut = mOut & s & vbCrLf
End Sub

' Next to the project file when there is one, TEMP otherwise. Never the Office
' install folder - that's read-only on a managed machine.
Private Function OutPath(ByVal app As Object) As String
    Dim folder As String
    On Error Resume Next
    folder = app.ActiveProject.Path
    Err.Clear
    If Len(folder) = 0 Then folder = Environ$("TEMP")
    If Len(folder) = 0 Then folder = Environ$("USERPROFILE")
    On Error GoTo 0
    OutPath = folder & "\RS_ProjectModel.txt"
End Function

Private Function WriteOut(ByVal path As String) As Boolean
    Dim f As Integer
    On Error GoTo Nope
    f = FreeFile
    Open path For Output As #f
    Print #f, mOut
    Close #f
    WriteOut = True
    Exit Function
Nope:
    On Error Resume Next
    Close #f
    WriteOut = False
End Function
